# ─────────────────────────────────────────────
# 振佳空調 hvac-inventory 環境變數（範本）
# ─────────────────────────────────────────────
# 複製本檔為 .env，填入實際值。

# Discord Webhook（外網/監控通知 — monitor.ps1 / tunnel-notify.ps1 / watchdog-check.ps1）
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here

# Google 行事曆同步失敗通知（sync_scheduler.py）
GCAL_SYNC_WEBHOOK_URL=your-gcal-sync-webhook-url-here
GCAL_SYNC_THREAD_ID=your-thread-id-here
